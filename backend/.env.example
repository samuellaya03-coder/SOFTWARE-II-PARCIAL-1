# Puerto del servidor backend
PORT=3001

# Orígenes CORS permitidos (separados por coma). Los túneles *.trycloudflare.com están autorizados dinámicamente.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clave de API de Google Gemini para CyberTutor IA
GEMINI_API_KEY=tu_api_key_aqui

# Configuración SMTP para despacho de correos (Opcional)
# Si se dejan en blanco, el sistema utiliza automáticamente Ethereal Email de prueba y genera enlaces de previsualización web.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM="CyberSec Lab" <tu_correo@gmail.com>

# Copia este archivo como backend/.env y ajusta lo que necesites.
# Todos los valores tienen un defecto razonable; config.js valida el formato al
# arrancar y aborta con un mensaje claro si algo no cuadra.

NODE_ENV=development
PORT=3001

# Origenes autorizados, separados por comas. "*" solo se admite fuera de
# produccion: con NODE_ENV=production el arranque falla si aparece.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limites de tamano
MAX_UPLOAD_MB=25
MAX_JSON_MB=2

# Limitacion de peticiones. El cupo "HEAVY" se aplica a las rutas costosas:
# derivacion de clave, generacion de RSA-4096 y analisis forense.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_HEAVY_MAX=20

# Pool de analisis forense. Por defecto, nucleos disponibles menos uno (max 4).
# FORENSICS_WORKERS=4
FORENSICS_JOB_TIMEOUT_MS=60000
